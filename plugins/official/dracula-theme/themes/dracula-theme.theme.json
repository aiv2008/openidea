// Dracula Theme: UI theme. Keys are the CSS variables of src/styles/tokens.css,
// grouped like its Islands Light block. Delete a line to keep the built-in value
// of the base named by "kind". Comments are allowed (// and /* */).
// Full reference: docs/plugins/themes.md.
{
  "id": "dracula-theme",
  "name": "Dracula Theme",
  "kind": "dark",
  "tokens": {
    // Surfaces
    "--bg-app": "#282a36",
    "--bg-elev": "#2f3140",
    "--bg-popup": "#343746",
    "--bg-floating-toolbar": "#343746",
    "--bg-hover": "#3b3e52",
    "--bg-selected": "#443d63",
    "--bg-selected-strong": "#544b7a",
    "--bg-current-line": "#323442",
    "--bg-debug-line": "#4a3f70",
    "--bg-backdrop": "#343746",
    "--bg-input": "#21222c",

    // Lines
    "--border": "#343746",
    "--border-popup": "#3f4257",
    "--border-strong": "#4e5266",
    "--border-window": "#4e5266",
    "--control-off": "#6f7391",

    // Text
    "--fg-strong": "#f8f8f2",
    "--fg-emphasis": "#f8f8f2",
    "--fg": "#f8f8f2",
    "--fg-secondary": "#b6bad2",
    "--fg-muted": "#9fa3bd",
    "--fg-subtle": "#8b8fa8",
    "--fg-faint": "#6f7391",
    "--fg-gutter": "#6272a4",
    "--fg-icon": "#d7d9e8",

    // Accent (Dracula's purple, with the cyan for links)
    "--accent": "#bd93f9",
    "--link": "#8be9fd",
    "--link-hover": "#a4ffff",

    // Charts
    "--chart-series": "#ff79c6",

    // Status
    "--danger": "#ff5555",
    "--warning": "#ffb86c",
    "--success": "#50fa7b",
    "--db-connected": "#50fa7b",
    "--db-connected-ring": "#2a5b3c",
    "--info": "#8be9fd",

    // Vcs
    "--vcs-modified": "#8be9fd",
    "--vcs-added": "#50fa7b",
    "--vcs-deleted": "#6272a4",
    "--vcs-untracked": "#ffb86c",
    "--vcs-ignored": "#6f7391",
    "--vcs-conflict": "#ff5555",
    "--gutter-modified": "#62c2da",
    "--gutter-added": "#45c96a",
    "--gutter-deleted": "#6f7391",
    "--diff-modified": "#2f3f57",
    "--diff-inserted": "#24402e",
    "--diff-deleted": "#3a3d4d",
    "--diff-modified-stripe": "#4a6a8f",
    "--diff-inserted-stripe": "#3d7a4f",
    "--diff-deleted-stripe": "#5f6478",
    "--diff-conflict-stripe": "#b0544a",

    // Shadows and window controls
    "--shadow-popup": "0 6px 20px rgba(0, 0, 0, 0.45)",
    "--shadow-dialog": "0 0 0 0.5px rgba(0, 0, 0, 0.6), 0 10px 24px rgba(0, 0, 0, 0.35), 0 24px 72px rgba(0, 0, 0, 0.45)",
    "--traffic-close": "#ff5f57",
    "--traffic-close-border": "#e0443e",
    "--traffic-close-pressed": "#bf4942",
    "--traffic-glyph": "#4d0000",
    "--traffic-off": "#404955",
    "--traffic-off-border": "#363e49",

    // Additive
    "--bg-stripe-tooltip": "var(--bg-tooltip)",
    "--fg-stripe-tooltip": "var(--fg-tooltip)",
    "--border-stripe-tooltip": "var(--border-tooltip)",
    "--shadow-stripe-tooltip": "var(--shadow-tooltip)",
    "--bg-tooltip": "#3f4257",
    "--fg-tooltip": "#f8f8f2",
    "--border-tooltip": "#3f4257",
    "--bg-control": "#343746",
    "--bg-control-hover": "#3f4257",
    "--bg-active": "#4e5266",
    "--bg-scrim": "rgba(0, 0, 0, 0.45)",
    "--fg-on-accent": "#282a36",
    "--shadow-tooltip": "0 4px 12px rgba(0, 0, 0, 0.4)",
    "--shadow-balloon": "0 8px 24px rgba(0, 0, 0, 0.45)",

    // Islands contract
    "--bg-frame": "#343746",
    "--bg-island": "#282a36",
    "--bg-stripe-hover": "#ffffff17",
    "--bg-stripe-selected": "#ffffff29",
    "--fg-stripe-selected-active": "#ffffff",
    "--fg-stripe-label": "#b6bad2",
    "--bg-tab-selected": "#3f3a5c",
    "--border-tab-selected": "#bd93f9",
    "--bg-tab-selected-inactive": "#343746",
    "--border-tab-selected-inactive": "#4e5266",
    "--bg-tab-hover": "#ffffff17",
    "--border-editor-tabs": "#343746",
    "--bg-tree-selected": "#443d63",
    "--bg-tree-selected-inactive": "#3a3d50",
    "--bg-tree-hover": "#ffffff10",
    "--bg-toolbar-hover": "#ffffff17",
    "--bg-toolbar-pressed": "#ffffff29",
    "--bg-toolbar-selected": "#544b7a",
    "--bg-toolbar-selected-hover": "#645a90",
    "--bg-button-primary-hover": "#cbaefc",
    "--fg-button-primary": "#282a36",
    "--bg-button": "transparent",
    "--border-button": "#4e5266",
    "--bg-field": "#21222c",
    "--bg-checkbox": "#21222c",
    "--border-checkbox": "#6f7391",
    "--bg-toggle-on": "#4bbf6b",
    "--fg-toggle-on": "#1b1c24",
    "--bg-toggle-off": "#21222c",
    "--fg-toggle-off": "#8b8fa8",
    "--border-toggle": "#6f7391",
    "--bg-toggle-knob": "#6f7391",
    "--focus-ring-soft": "#7c6bb0",
    "--scrollbar-thumb": "#ffffff33",
    "--scrollbar-thumb-hover": "#ffffff59",
    "--bg-search-match": "#9a8f4e",
    "--bg-search-match-current": "#f1fa8c",
    "--fg-search-match": "#282a36",
    "--bg-dialog": "#282a36",
    "--bg-popup-inline": "#343746",
    "--bg-popup-advertiser": "#343746",
    "--bg-feedback-info": "#383051",
    "--border-feedback-info": "#5a4a86",
    "--bg-feedback-error": "#4a2a30",
    "--border-feedback-error": "#7a3b44",
    "--bg-feedback-warning": "#4a3a24",
    "--border-feedback-warning": "#7a5a2e",
    "--bg-feedback-success": "#243a2c",
    "--border-feedback-success": "#2f5c40",
    "--bg-counter": "#6f7391",
    "--fg-counter": "#21222c",
    "--bg-progress-track": "#4e5266"
  }
}
