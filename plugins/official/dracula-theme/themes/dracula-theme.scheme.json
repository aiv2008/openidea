// Dracula Theme: editor colour scheme (syntax, editor surfaces, console ANSI colours),
// the counterpart of an IntelliJ .icls file. Merged over the UI theme's tokens.
{
  "name": "Dracula Theme",
  "tokens": {
    // Syntax
    "--syn-keyword": "#ff79c6",
    "--syn-string": "#f1fa8c",
    "--syn-type": "#8be9fd",
    "--syn-function": "#50fa7b",
    "--syn-function-call": "#50fa7b",
    "--syn-comment": "#6272a4",
    "--syn-comment-style": "normal",
    "--syn-doc-comment": "#6272a4",
    "--syn-doc-comment-tag": "#bd93f9",
    "--syn-doc-comment-tag-effect": "none",
    "--syn-doc-comment-tag-value": "#f8f8f2",
    "--syn-doc-markup": "#f1fa8c",
    "--syn-doc-markup-bg": "transparent",
    "--syn-docstring": "#f1fa8c",
    "--syn-annotation": "#ffb86c",
    "--syn-decorator": "#ffb86c",
    "--syn-number": "#bd93f9",
    "--syn-punct": "#f8f8f2",
    "--syn-variable": "#f8f8f2",
    "--syn-global": "#f8f8f2",
    "--syn-namespace": "#8be9fd",
    "--syn-param": "#ffb86c",
    "--syn-property": "#8be9fd",
    "--syn-constant": "#bd93f9",
    "--syn-python-local-variable": "#f8f8f2",
    "--syn-python-global-variable": "#f8f8f2",
    "--syn-python-instance-attribute": "#f8f8f2",
    "--syn-python-class-attribute": "#8be9fd",
    "--syn-python-constant": "#bd93f9",
    "--syn-python-property": "#8be9fd",
    "--syn-python-type-parameter": "#8be9fd",
    "--syn-python-builtin": "#8be9fd",
    "--syn-python-predefined-definition": "#50fa7b",
    "--syn-python-predefined-usage": "#50fa7b",
    "--syn-python-fstring": "#f1fa8c",
    "--syn-python-bytes": "#f1fa8c",
    "--syn-python-docstring-tag": "#bd93f9",
    "--syn-python-docstring-tag-effect": "none",
    "--syn-python-docstring-keyword": "#8be9fd",
    "--syn-php-variable": "#f8f8f2",
    "--syn-php-function-call": "#50fa7b",
    "--syn-builtin": "#8be9fd",
    "--syn-self": "#ff79c6",
    "--syn-keyword-arg": "#ff79c6",
    "--syn-predefined": "#8be9fd",
    "--syn-escape": "#ff79c6",
    "--syn-regexp": "#ff5555",
    "--syn-tag": "#ff79c6",
    "--syn-attribute": "#50fa7b",
    "--syn-todo": "#f1fa8c",
    "--syn-link": "#8be9fd",
    "--syn-markup-heading": "#bd93f9",
    "--syn-markup-code": "#f1fa8c",
    "--syn-invalid": "#ff5555",
    "--syn-inline-value": "#6272a4",
    "--syn-rainbow-1": "#8be9fd",
    "--syn-rainbow-2": "#ff79c6",
    "--syn-rainbow-3": "#50fa7b",
    "--syn-rainbow-4": "#f1fa8c",
    "--syn-rainbow-5": "#bd93f9",
    "--syn-bracket-1": "#ff79c6",
    "--syn-bracket-2": "#bd93f9",
    "--syn-bracket-3": "#8be9fd",

    // Editor
    "--fg-editor": "#f8f8f2",
    "--caret": "#f8f8f2",
    "--fg-line-number": "#6272a4",
    "--fg-line-number-current": "#f8f8f2",
    "--border-gutter": "#21222c",
    "--border-indent-guide": "#343746",
    "--border-indent-guide-active": "#4e5266",
    "--border-right-margin": "#343746",
    "--bg-editor-selection": "#44475a",
    "--bg-editor-selection-inactive": "#383a46",
    "--bg-text-search-result": "#423b63",
    "--bg-text-search-result-current": "#574e86",
    "--bg-matched-brace": "#44475a",
    "--matched-brace-weight": "700",
    "--bg-matched-tag": "#3f4257",
    "--bg-fold-placeholder": "#343746",
    "--fg-fold-placeholder": "#6272a4",
    "--fg-fold-marker": "#6f7391",
    "--fg-whitespace": "#3f4257",
    "--fg-unused": "#6272a4",
    "--bg-identifier-under-caret": "#323442",
    "--bg-identifier-under-caret-write": "#4a2f3f",
    "--fg-inlay": "#8b8fa8",
    "--bg-inlay": "#343746",
    "--wave-error": "#ff5555",
    "--wave-warning": "#ffb86c",
    "--editor-error-decoration": "underline wavy #ff5555",
    "--editor-warning-decoration": "underline wavy #ffb86c",
    "--editor-warning-background": "transparent",
    "--bg-breakpoint-line": "#4a2a35",
    "--fg-completion-match": "#8be9fd",
    "--bg-editor-inline": "#21222c",
    "--bg-editor-banner": "#4a3f70",
    "--fg-weak-warning": "#8b8fa8",
    "--fg-bulb": "#ffb86c",

